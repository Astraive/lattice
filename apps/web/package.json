{
  "name": "@lattice/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "cargo build -p lattice-web-wasm --target wasm32-unknown-unknown --release --locked && wasm-bindgen ../../target/wasm32-unknown-unknown/release/lattice_web_wasm.wasm --target web --out-dir src/wasm --out-name lattice_web_wasm",
    "build": "bun run build:wasm && tsc --noEmit && vite build",
    "check": "bun run build:wasm && tsc --noEmit --pretty false",
    "dev": "bun run build:wasm && vite --host 127.0.0.1 --port 1430 --strictPort",
    "lint": "biome check src vite.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 1430 --strictPort",
    "test": "bun test"
  },
  "dependencies": {
    "@lattice/theme": "workspace:*",
    "@lattice/ui-shared": "workspace:*",
    "@lattice/ui-web": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@lattice/config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
