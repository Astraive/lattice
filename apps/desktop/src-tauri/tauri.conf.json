{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattice",
  "version": "0.1.0",
  "identifier": "com.astraive.lattice",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lattice",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1421; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../assets/logo/generated/32x32.png",
      "../../../assets/logo/generated/128x128.png",
      "../../../assets/logo/generated/128x128@2x.png",
      "../../../assets/logo/generated/icon.icns",
      "../../../assets/logo/generated/icon.ico"
    ]
  }
}
